# Environment that this is running in (local, staging, production)
# must set UNIQUE_CONFIGURATION_CHECK to 1 in .env to signal that this is not just copied from example.env

UNIQUE_CONFIGURATION_CHECK=0

SERVER_ENV=local
BOOTSTRAP_SAMPLE_DATA=0
PLATFORM_LINUX=1

# Default to the postgres sidecar in .devcontainer/docker-compose.yml
DB_PATH_OR_CONNECTION_STRING=postgresql+psycopg://powerchoice:powerchoice_dev_password@postgres:5432/powerchoice

# Optional sqlite fallback for quick local experiments
# DB_PATH_OR_CONNECTION_STRING=sqlite:///local.db

APPLICATION_SERVER_PORT=8100
APP_LOGIN_PATH=login

# WARNING - This code is a development code; change to a appropriate value and delete this line in production.
ANALYTIC_TRACKING_TOKEN="4d211afece5d"
# SMTP-JINJA direct mail (ssl and tls are mutually exclusive in the client)
# Port 465 → SSL=1 TLS=0 (implicit TLS). Port 587 → SSL=0 TLS=1 (STARTTLS).
DIRECT_EMAIL_FROM_NAME=PowerChoice Service
DIRECT_EMAIL_FROM_ADDRESS=no_reply@example.com
DIRECT_EMAIL_SMTP_HOST=mail.example.com
DIRECT_EMAIL_SMTP_PORT=587
DIRECT_EMAIL_SMTP_TLS=1
DIRECT_EMAIL_SMTP_SSL=0
DIRECT_EMAIL_SMTP_USER=no_reply@example.com
DIRECT_EMAIL_SMTP_PASSWORD=<specify>
DIRECT_EMAIL_SMTP_TIMEOUT=20
DIRECT_TEMPLATE_DIRECTORY=../email_templates
USE_EMAIL_SERVICE=SMTP-JINJA
EMAIL_SYNC_ASYNC=async
EMAIL_BRAND_NAME=Power Choice Pro
EMAIL_SUPPORT_EMAIL=

SG_KEY=SG.supply_key_from_sendgrid
# template_code:sendgrid_template_id,...  (SMTP-only installs may leave empty)
# SENDGRID_TEMPLATE_IDS=password_reset:d-xxx,share_project_vote:d-yyy
SENDGRID_TEMPLATE_IDS=<insert here>

STRIPE_ENDPOINT_SECRET_PRIMARY=whsec_secret
JWT_SECRET_KEY=always_cahnge_rc02hm73wk7banru834ozh6dx6s1rt18kdrf0kdot8j0xp5ubi6alvl9w25
JWT_REFRESH_SECRET_KEY=always_change_ey826je7r6uz0n6ekv6bqu8cxw7skod9t42wgk2i2ky0jnh8uhtgaud3s59a6kpk4fm
BOOTSTRAP_CUSTOMER_EMAIL=set_for_bootstrap
BOOTSTRAP_ADMIN_USER_EMAIL=set_for_bootstrap
BOOTSTRAP_ADMIN_PASSWORD=set_for_bootstrap
BOOTSTRAP_NON_ADMIN_USER_EMAIL=set_for_bootstrap
BOOTSTRAP_NON_ADMIN_PASSWORD=set_for_bootstrap
# TRIAL_ACCOUNT_CODES=trial_code_10:10,trial_code_30:30
# Comma-separated field names stripped from user_record and customer_record on context/session
# responses. Multiple values allowed. Empty string disables masking. Default is stripe_settings.
# CONTEXT_MASKED_FIELDS=stripe_settings

# Restrict email 2FA and share verification codes to digits (weaker entropy; easier to type). Default 0.
# TOKEN_SECURITY_DIGITS_ONLY=0

# Login email 2FA: disabled | sysadmins | admins | admins+optin | all
# LOGIN_2FA_MODE=disabled
# LOGIN_2FA_VALIDITY_MINUTES=10
# LOGIN_2FA_VALIDITY_MESSAGE=10 minutes
# LOGIN_2FA_RESEND_LIMIT_SECONDS=60
# SENDGRID_TEMPLATE_IDS may include login_2fa:d-xxxxx

# Unauthenticated share-gate throttle (0 disables a given cap)
# SHARE_GATE_THROTTLE_WINDOW_SECONDS=3600
# SHARE_GATE_MAX_UNAUTH_PER_IP_PER_HOUR=60
# SHARE_GATE_MAX_FAILURES_PER_IP_PER_HOUR=20
# SHARE_GATE_MAX_FAILURES_PER_TOKEN_PER_HOUR=10

# User communication is activated by pvf_app_startup.yaml
# features.activate_customer_communication.
# MAX_REPORTS_PER_DAY=10

# Server-side AI (gated by pvf_app_startup.yaml features.activate_ai_agents).
# System fallback provider when a customer has not configured BYOK credentials.
# AI_SERVICE=opencode_go
# AI_API_KEY=
# AI_MODEL=glm-5.2
# AI_BASE_URL=
# AI_HTTP_TIMEOUT_SECONDS=30
# AI_HTTP_RETRIES=3
# Optional dedicated key for encrypting customer AI keys; JWT_SECRET_KEY is used if unset.
# PVF_FIELD_ENCRYPTION_KEY=
# Application worker caps (PowerChoice voting orchestration)
# AI_MAX_CONCURRENT_PROJECTS=2
# AI_MAX_PAIRS_PER_PROJECT=500

# Cloudflare Tunnel for external dev access via powerchoice-dev.prattventures.net
# Create a named tunnel in Cloudflare Zero Trust → Networks → Tunnels → Cloudflared,
# set Public Hostname powerchoice-dev.prattventures.net → http://localhost:8100,
# copy the tunnel token and place it here. Then run: ./scripts/start_cloudflare.sh
# Leave empty to use an ephemeral *.trycloudflare.com quick tunnel instead.
# CLOUDFLARE_TUNNEL_TOKEN=<need to enable cloudflare tunnel>
